{
  "name": "@podman-desktop/eslint-config",
  "version": "0.0.1",
  "description": "Shared ESLint config enforcing @podman-desktop's code style",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint:fix": "eslint --flag unstable_native_nodejs_ts_config --cache . --cache-strategy content --fix",
    "lint:check": "eslint --flag unstable_native_nodejs_ts_config --cache . --cache-strategy content",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "typescript": ">=5"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.8.1",
  "license": "Apache-2.0"
}
