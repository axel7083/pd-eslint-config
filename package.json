{
  "name": "@podman-desktop/eslint-config",
  "version": "0.0.1",
  "description": "Shared ESLint config enforcing @podman-desktop's code style",
  "type": "module",
  "exports": {
    "./base": {
      "import": "./dist/base.js",
      "types": "./dist/base.d.ts"
    },
    "./svelte": {
      "import": "./dist/svelte.js",
      "types": "./dist/svelte.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "lint:fix": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js --flag unstable_native_nodejs_ts_config --cache . --cache-strategy content --fix",
    "lint:check": "node --max-old-space-size=8192 node_modules/eslint/bin/eslint.js --flag unstable_native_nodejs_ts_config --cache . --cache-strategy content",
    "typecheck:config": "tsc --project tsconfig.config.json --noEmit",
    "typecheck:src": "tsc --project tsconfig.json --noEmit",
    "typecheck": "pnpm run typecheck:config && pnpm run typecheck:src"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "typescript": ">=5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/kit": "^2.69.0",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.20.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3"
  },
  "license": "Apache-2.0"
}
